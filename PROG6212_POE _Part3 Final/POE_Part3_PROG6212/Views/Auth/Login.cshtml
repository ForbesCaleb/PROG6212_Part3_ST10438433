@model POE_Part2_PROG6212.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="d-flex justify-content-center align-items-center" style="height:85vh;">
    <div class="card card-dark shadow-lg p-4" style="width:420px;">
        <h3 class="text-center text-light mb-4">
            <i data-lucide="lock"></i> Sign In
        </h3>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label asp-for="Username" class="form-label text-light"></label>
                <input asp-for="Username" class="form-control bg-dark text-light border-secondary" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label text-light"></label>
                <input asp-for="Password" type="password"
                       class="form-control bg-dark text-light border-secondary" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label text-light"></label>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                <i data-lucide="log-in"></i> Login
            </button>
        </form>
    </div>
</div>

<script>
    lucide.createIcons();
</script>
