@model IEnumerable<POE_Part2_PROG6212.Models.AppUser>

@{
    ViewData["Title"] = "Manage Users";
}

<h2 class="mb-4">Manage Users</h2>

<a asp-action="CreateUser" class="btn btn-primary mb-3">
    <i data-lucide="user-plus"></i> Add New User
</a>

<div class="card card-dark p-3">
    <table class="table table-dark table-striped align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Username</th>
                <th>Full Name</th>
                <th>Role</th>
                <th>Hourly Rate</th>
                <th style="width: 180px;">Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.Id</td>
                    <td>@u.Username</td>
                    <td>@u.FullName</td>
                    <td>@u.Role</td>
                    <td>@(u.Role == "Lecturer" ? "R " + u.HourlyRate : "-")</td>

                    <td>
                        <a asp-action="EditUser" asp-route-id="@u.Id"
                           class="btn btn-warning btn-sm me-2">
                            <i data-lucide="edit"></i> Edit
                        </a>

                        <form asp-action="DeleteUser" asp-route-id="@u.Id"
                              method="post" style="display:inline;"
                              onsubmit="return confirm('Are you sure you want to delete this user?');">

                            <button class="btn btn-danger btn-sm">
                                <i data-lucide="trash"></i> Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    lucide.createIcons();
</script>
