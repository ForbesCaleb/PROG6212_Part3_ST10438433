@model IEnumerable<POE_Part2_PROG6212.Models.Claim>
@{
    ViewData["Title"] = "Lecturer Claims";
}

<h2 class="mb-4">Approved Claims</h2>

<div class="card card-dark p-3">
    <table class="table table-dark table-bordered">
        <thead>
            <tr>
                <th>Date Worked</th>
                <th>Hours</th>
                <th>Activity</th>
                <th>Total Amount (R)</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.DateWorked.ToString("yyyy-MM-dd")</td>
                    <td>@c.HoursWorked</td>
                    <td>@c.Activity</td>
                    <td>@c.TotalAmount.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script> lucide.createIcons(); </script>
