@model IEnumerable<POE_Part2_PROG6212.Models.AppUser>
@{
    ViewData["Title"] = "Manage Lecturers";
}

<h2 class="mb-4">Manage Lecturers</h2>

<a class="btn btn-primary mb-3" asp-action="CreateLecturer">
    <i data-lucide="user-plus"></i> Add New Lecturer
</a>

<table class="table table-hover table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Username</th>
            <th>Hourly Rate</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FullName</td>
                <td>@user.Username</td>
                <td>R @user.HourlyRate</td>
                <td>
                    <a asp-action="EditLecturer" asp-route-id="@user.Id" class="btn btn-outline-light btn-sm">
                        Edit
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
