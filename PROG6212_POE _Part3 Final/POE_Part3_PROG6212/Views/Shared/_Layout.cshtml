@using System.Security.Claims
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpCtx

@{
    var user = HttpCtx.HttpContext.User;

    string fullName = user.FindFirst(ClaimTypes.Name)?.Value ?? "User";
    string role = user.FindFirst(ClaimTypes.Role)?.Value ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - CMCS</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <script src="https://unpkg.com/lucide@latest"></script>
</head>

<body class="bg-dark text-light">

    <div class="d-flex">

        <!-- ===================== SIDEBAR ===================== -->
        <aside class="sidebar bg-black p-3" style="width:260px; min-height:100vh;">
            <h2 class="text-white mb-4">CMCS</h2>

            <ul class="nav flex-column">

                <!-- ALL ROLES: Dashboard -->
                <li class="nav-item mb-2">
                    <a asp-controller="Dashboard" asp-action="Index" class="nav-link text-light">
                        <i data-lucide="home"></i> Dashboard
                    </a>
                </li>

                <!-- ========================= HR ========================= -->
                @if (role == "HR")
                {
                    <li class="nav-item mb-2">
                        <a asp-controller="Hr" asp-action="Index" class="nav-link text-light">
                            <i data-lucide="layout-dashboard"></i> HR Dashboard
                        </a>
                    </li>

                    <li class="nav-item mb-2">
                        <a asp-controller="Hr" asp-action="Users" class="nav-link text-light">
                            <i data-lucide="users"></i> Manage Users
                        </a>
                    </li>

                    <li class="nav-item mb-2">
                        <a asp-controller="Hr" asp-action="InvoiceSummary" class="nav-link text-light">
                            <i data-lucide="file-text"></i> Invoice Summary
                        </a>
                    </li>
                }

                <!-- ========================= LECTURER ========================= -->
                @if (role == "Lecturer")
                {
                    <li class="nav-item mb-2">
                        <a asp-controller="Dashboard" asp-action="SubmitClaim" class="nav-link text-light">
                            <i data-lucide="edit"></i> Submit Claim
                        </a>
                    </li>

                    <li class="nav-item mb-2">
                        <a asp-controller="Dashboard" asp-action="MyClaims" class="nav-link text-light">
                            <i data-lucide="list"></i> My Claims
                        </a>
                    </li>
                }

                <!-- ========================= PC / AM ========================= -->
                @if (role == "ProgrammeCoordinator" || role == "AcademicManager")
                {
                    <li class="nav-item mb-2">
                        <a asp-controller="Management" asp-action="ReviewClaims" class="nav-link text-light">
                            <i data-lucide="check-circle"></i> Review Claims
                        </a>
                    </li>
                }
            </ul>

        </aside>

        <!-- ===================== MAIN CONTENT ===================== -->
        <main class="flex-grow-1 p-4">

            <!-- TOP NAV WITH LOGOUT -->
            <div class="d-flex justify-content-end mb-3">
                <form asp-controller="Auth" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-outline-light">
                        <i data-lucide="log-out"></i> Logout
                    </button>
                </form>
            </div>

            <h1 class="mb-4">@ViewData["Title"]</h1>

            @RenderBody()

        </main>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        lucide.createIcons();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
