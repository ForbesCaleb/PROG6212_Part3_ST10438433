@using System.Security.Claims
@{
    var role = User.FindFirstValue(ClaimTypes.Role) ?? "";
    var name = User.Identity?.Name ?? "User";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - CMCS</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        /* ========= BASE DARK MODE ========= */
        body {
            background-color: #181818;
            color: #f5f5f5;
        }

        .sidebar {
            width: 240px;
            background-color: #111;
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            padding: 20px 0;
            border-right: 1px solid #333;
        }

            .sidebar a {
                color: #ccc;
                padding: 12px 20px;
                display: block;
                text-decoration: none;
                font-size: 15px;
            }

                .sidebar a:hover {
                    background-color: #222;
                    color: #fff;
                }

            .sidebar .active {
                background-color: #333;
                color: white;
            }

        .topbar {
            margin-left: 240px;
            height: 60px;
            background-color: #111;
            padding: 10px 20px;
            border-bottom: 1px solid #333;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .content-area {
            margin-left: 240px;
            padding: 25px;
        }

        .card-dark {
            background-color: #222;
            border: 1px solid #444;
            border-radius: 10px;
            padding: 20px;
        }

        /* ========= DARK MODE VISIBILITY FIXES ========= */

        /* Force readable text inside tables */
        .table-dark,
        .table-dark td,
        .table-dark th {
            color: #f5f5f5 !important;
            background-color: #1e1e1e !important;
        }

        .table-striped > tbody > tr:nth-of-type(odd) {
            background-color: #252525 !important;
        }

        /* List items readable */
        .list-group-item {
            color: #f5f5f5 !important;
            background-color: #1f1f1f !important;
            border-color: #333 !important;
        }

        /* Card headers readable */
        .card-dark h4,
        .card-dark h5,
        .card-dark h6,
        .card-dark p,
        .card-dark span {
            color: #ffffff !important;
        }

        /* Form labels & inputs readable */
        label, .form-label {
            color: #ffffff !important;
        }

        input, textarea, select {
            color: #ffffff !important;
            background-color: #1e1e1e !important;
            border-color: #444 !important;
        }

        ::placeholder {
            color: #bbbbbb !important;
        }

        /* Alerts readable */
        .alert {
            color: #ffffff;
        }
    </style>
</head>

<body>
    @await Html.PartialAsync("~/Views/Shared/_Sidebar.cshtml")

    @await Html.PartialAsync("~/Views/Shared/_TopNav.cshtml")

    <div class="content-area">
        @await Html.PartialAsync("~/Views/Shared/_Alerts.cshtml")
        @RenderBody()
    </div>

    <script>
        lucide.createIcons();
    </script>
</body>
</html>
