@using System.Security.Claims
@{
    var role = User.FindFirstValue(ClaimTypes.Role) ?? "";
}

<aside class="sidebar">
    <div class="px-4 mb-4">
        <h4 class="text-light">CMCS</h4>
    </div>

    <a asp-controller="Dashboard" asp-action="Index">
        <i data-lucide="home"></i> Dashboard
    </a>

    @if (role == "Lecturer")
    {
        <a asp-controller="Dashboard" asp-action="SubmitClaim"><i data-lucide="file-plus"></i> Submit Claim</a>
        <a asp-controller="Dashboard" asp-action="MyClaims"><i data-lucide="list"></i> My Claims</a>
    }

    @if (role == "ProgrammeCoordinator" || role == "AcademicManager")
    {
        <a asp-controller="Management" asp-action="ReviewClaims">
            <i data-lucide="check-square"></i> Review Claims
        </a>
    }

    @if (role == "HR")
    {
        <a asp-controller="Hr" asp-action="Index"><i data-lucide="users"></i> HR Dashboard</a>
        <a asp-controller="Hr" asp-action="Lecturers"><i data-lucide="user-cog"></i> Manage Lecturers</a>
        <a asp-controller="Hr" asp-action="InvoiceSummary"><i data-lucide="file-text"></i> Invoice Summary</a>
    }
</aside>
