@model IEnumerable<POE_Part3_PROG6212.Models.Claim>
@{
    ViewData["Title"] = "My Claims";
}

<h2 class="mb-4">My Claims</h2>

<div class="card card-dark p-3">
    <table class="table table-dark table-striped">
        <thead>
            <tr>
                <th>Date</th>
                <th>Hours</th>
                <th>Activity</th>
                <th>Total (R)</th>
                <th>Status</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.DateWorked.ToString("yyyy-MM-dd")</td>
                    <td>@c.HoursWorked</td>
                    <td>@c.Activity</td>
                    <td>@c.TotalAmount.ToString("N2")</td>
                    <td>@c.Status</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    lucide.createIcons();
</script>
