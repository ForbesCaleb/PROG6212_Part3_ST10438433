@using POE_Part2_PROG6212.Models
@{
    ViewData["Title"] = "Dashboard";
    var role = ViewBag.Role as string ?? "";
}

<h2 class="mb-4">Dashboard</h2>

@if (role == "Lecturer")
{
    <div class="row">
        <div class="col-md-4">
            <div class="card card-dark mb-3">
                <h5 class="text-light">Pending Claims</h5>
                <p class="display-6 text-warning">@ViewBag.PendingCount</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card card-dark mb-3">
                <h5 class="text-light">Approved</h5>
                <p class="display-6 text-success">@ViewBag.ApprovedCount</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card card-dark mb-3">
                <h5 class="text-light">Rejected</h5>
                <p class="display-6 text-danger">@ViewBag.RejectedCount</p>
            </div>
        </div>
    </div>

    <div class="card card-dark">
        <h4>Recent Claims</h4>
        <table class="table table-dark table-striped">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Hours</th>
                    <th>Activity</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var c in ViewBag.RecentClaims)
                {
                    <tr>
                        <td>@c.DateWorked.ToString("yyyy-MM-dd")</td>
                        <td>@c.HoursWorked</td>
                        <td>@c.Activity</td>
                        <td>@c.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (role == "HR")
{
    <div class="row">
        <div class="col-md-3">
            <div class="card card-dark p-3 mb-3">
                <h6>Total Users</h6>
                <p class="display-6">@ViewBag.TotalUsers</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card card-dark p-3 mb-3">
                <h6>Total Lecturers</h6>
                <p class="display-6">@ViewBag.TotalLecturers</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card card-dark p-3 mb-3">
                <h6>Total Claims</h6>
                <p class="display-6">@ViewBag.TotalClaims</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card card-dark p-3 mb-3">
                <h6>Pending</h6>
                <p class="display-6 text-warning">@ViewBag.PendingClaims</p>
            </div>
        </div>
    </div>

    <div class="card card-dark p-3">
        <h4>Recent Users</h4>
        <ul class="list-group">
            @foreach (var u in ViewBag.RecentUsers)
            {
                <li class="list-group-item bg-dark text-light border-secondary">
                    @u.FullName (@u.Username)
                </li>
            }
        </ul>
    </div>
}

@if (role == "ProgrammeCoordinator" || role == "AcademicManager")
{
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card card-dark p-3">
                <h5>Pending Approvals</h5>
                <p class="display-6 text-warning">@ViewBag.PendingApproval</p>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card card-dark p-3">
                <h5>Total Claims</h5>
                <p class="display-6">@ViewBag.TotalClaims</p>
            </div>
        </div>
    </div>

    <div class="card card-dark p-3">
        <h4>Recent Claims</h4>
        <table class="table table-dark table-striped">
            <thead>
                <tr>
                    <th>Lecturer</th>
                    <th>Date</th>
                    <th>Hours</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var c in ViewBag.RecentClaims)
                {
                    <tr>
                        <td>@c.User.FullName</td>
                        <td>@c.DateWorked.ToString("yyyy-MM-dd")</td>
                        <td>@c.HoursWorked</td>
                        <td>@c.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
